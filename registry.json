      "enabled": true,
      "icon": "download"
    },
    {
      "id": "tools",
      "name": "Tools",
      "folder": "tools",
      "enabled": true,
      "icon": "tools"
    },
    {
      "id": "canvas",
      "name": "Canvas",
      "folder": "canvas",
      "enabled": true,
      "icon": "canvas"
    },
    {
      "id": "random",
      "name": "Random",
      "folder": "random",
      "enabled": true,
      "icon": "random"
    }
